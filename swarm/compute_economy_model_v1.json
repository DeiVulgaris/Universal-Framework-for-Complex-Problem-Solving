{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufcps.org/swarm/compute_economy_model_v1.json",
  "title": "UFCPS Compute Economy Model v1 — Dual Payment Rails",
  "description": "Machine-readable economic model for the UFCPS distributed compute economy. Supports two optional internal settlement rails: non-crypto Resource Credits for service consumption and an optional crypto asset rail for participants who prefer transferable crypto settlement. The model is experimental and is not a promise of financial return. Internal conversion between crypto and Resource Credits may be operated with zero UFCPS protocol commission and zero internal spread; any external blockchain network fee is not an UFCPS commission and must be disclosed separately. Every transaction carries the mandatory author royalty of 0.001% (0.00001 of transaction amount), regardless of payment rail.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_version",
    "currency",
    "compute_market",
    "issuance",
    "settlement",
    "stability",
    "risk",
    "scenarios"
  ],
  "properties": {
    "model_version": {
      "type": "string",
      "const": "v1"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "simulation",
        "candidate",
        "validated",
        "deprecated"
      ]
    },
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency_id",
        "name",
        "supply_policy"
      ],
      "properties": {
        "currency_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "reference_currency": {
          "type": "string"
        },
        "supply_policy": {
          "type": "string",
          "enum": [
            "fixed",
            "bounded",
            "elastic",
            "compute_linked",
            "hybrid",
            "experimental"
          ]
        },
        "maximum_supply": {
          "type": "number",
          "minimum": 0
        },
        "initial_supply": {
          "type": "number",
          "minimum": 0
        },
        "role": {
          "type": "string",
          "enum": [
            "crypto_asset",
            "fiat_reference",
            "internal_reference",
            "unspecified"
          ]
        },
        "instrument_type": {
          "type": "string",
          "enum": [
            "crypto_asset",
            "service_credit",
            "fiat",
            "reference_unit",
            "unspecified"
          ]
        }
      }
    },
    "compute_market": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demand",
        "supply",
        "pricing"
      ],
      "properties": {
        "demand": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline_units",
            "growth_rate"
          ],
          "properties": {
            "baseline_units": {
              "type": "number",
              "minimum": 0
            },
            "growth_rate": {
              "type": "number"
            },
            "demand_sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "supply": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline_units",
            "growth_rate"
          ],
          "properties": {
            "baseline_units": {
              "type": "number",
              "minimum": 0
            },
            "growth_rate": {
              "type": "number"
            },
            "provider_classes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "small_provider_share": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "utilization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minimum_viable_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "price_discovery"
          ],
          "properties": {
            "price_discovery": {
              "type": "string",
              "enum": [
                "fixed",
                "market",
                "auction",
                "negotiated",
                "dynamic_reference",
                "hybrid"
              ]
            },
            "reference_compute_unit": {
              "type": "string"
            },
            "base_price": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string"
            },
            "resource_adjustments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "accepted_units": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "service_price_anchor": {
              "type": "string",
              "enum": [
                "resource_credits",
                "fiat_reference",
                "crypto_market",
                "hybrid"
              ]
            },
            "crypto_conversion_reference": {
              "type": "string"
            }
          }
        }
      }
    },
    "issuance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "rate_policy",
        "limits"
      ],
      "properties": {
        "trigger": {
          "type": "string",
          "enum": [
            "verified_compute",
            "verified_settlement",
            "scheduled",
            "demand_linked",
            "hybrid",
            "experimental"
          ]
        },
        "rate_policy": {
          "type": "string",
          "enum": [
            "fixed_per_compute_unit",
            "dynamic",
            "market_clearing",
            "bounded_dynamic",
            "experimental"
          ]
        },
        "rate": {
          "type": "number",
          "minimum": 0
        },
        "rate_unit": {
          "type": "string"
        },
        "demand_adjustment": {
          "type": "number"
        },
        "utilization_adjustment": {
          "type": "number"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_issuance_per_period": {
              "type": "number",
              "minimum": 0
            },
            "max_issuance_rate": {
              "type": "number",
              "minimum": 0
            },
            "period": {
              "type": "string"
            }
          }
        }
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author_royalty_rate",
        "transaction_cost_model"
      ],
      "properties": {
        "author_royalty_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "const": 1e-05,
          "description": "Обязательный авторский гонорар с каждой транзакции."
        },
        "transaction_cost_model": {
          "type": "string",
          "enum": [
            "fixed",
            "percentage",
            "dynamic",
            "hybrid"
          ]
        },
        "base_transaction_fee": {
          "type": "number",
          "minimum": 0
        },
        "transaction_fee_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_settlement": {
          "type": "number",
          "minimum": 0
        },
        "batching_enabled": {
          "type": "boolean"
        },
        "micro_provider_settlement": {
          "type": "boolean"
        },
        "settlement_rails": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "resource_credits",
              "crypto",
              "fiat"
            ]
          }
        },
        "participant_preference_supported": {
          "type": "boolean"
        },
        "crypto_to_credit_conversion": {
          "type": "boolean"
        },
        "credit_to_crypto_conversion": {
          "type": "boolean"
        },
        "service_pricing_stability_policy": {
          "type": "string",
          "enum": [
            "anchor_in_resource_credits",
            "anchor_in_fiat_reference",
            "dynamic_crypto",
            "hybrid",
            "experimental"
          ]
        },
        "internal_conversion_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "crypto_to_resource_credits_fee_free",
            "hidden_fees_prohibited"
          ],
          "properties": {
            "crypto_to_resource_credits_fee_free": {
              "type": "boolean",
              "const": true
            },
            "resource_credits_to_crypto_fee_free": {
              "type": "boolean"
            },
            "hidden_fees_prohibited": {
              "type": "boolean",
              "const": true
            },
            "external_network_fees_disclosed": {
              "type": "boolean"
            }
          }
        },
        "author_royalty_basis": {
          "type": "string",
          "const": "every_transaction"
        },
        "author_royalty_mandatory": {
          "type": "boolean",
          "const": true
        },
        "author_royalty_exceptions": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string"
          }
        },
        "author_royalty_applies_to": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "resource_credit_purchase",
              "resource_credit_spend",
              "crypto_settlement",
              "crypto_to_resource_credit_conversion",
              "resource_credit_to_crypto_conversion",
              "compute_service",
              "data_access",
              "storage_service",
              "network_service",
              "research_service",
              "other_supported_transaction"
            ]
          }
        },
        "author_royalty_collection": {
          "type": "string",
          "enum": [
            "at_transaction_settlement",
            "atomic_with_transaction"
          ]
        }
      }
    },
    "liquidity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_liquidity_ratio": {
          "type": "number",
          "minimum": 0
        },
        "reserve_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "settlement_depth_target": {
          "type": "number",
          "minimum": 0
        },
        "redemption_mechanism": {
          "type": "string"
        },
        "liquidity_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resource_credit_liquidity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "source": {
              "type": "string"
            },
            "redeem_for_services_only": {
              "type": "boolean"
            }
          }
        },
        "crypto_liquidity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "source": {
              "type": "string"
            },
            "market_exposure": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "stability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "volatility_target",
        "stabilization_policy"
      ],
      "properties": {
        "volatility_target": {
          "type": "number",
          "minimum": 0
        },
        "measurement_window": {
          "type": "string"
        },
        "stabilization_policy": {
          "type": "string",
          "enum": [
            "none",
            "reserve",
            "dynamic_issuance",
            "dynamic_pricing",
            "liquidity_buffer",
            "hybrid",
            "experimental"
          ]
        },
        "circuit_breakers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provider_economics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hardware_cost": {
          "type": "number",
          "minimum": 0
        },
        "energy_cost_per_compute_unit": {
          "type": "number",
          "minimum": 0
        },
        "maintenance_cost_per_period": {
          "type": "number",
          "minimum": 0
        },
        "depreciation_per_period": {
          "type": "number",
          "minimum": 0
        },
        "target_margin": {
          "type": "number"
        },
        "small_provider_minimum_viable_contribution": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "network_externalities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compute_demand_multiplier": {
          "type": "number",
          "minimum": 0
        },
        "resource_network_multiplier": {
          "type": "number",
          "minimum": 0
        },
        "participant_growth_rate": {
          "type": "number"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_factors"
      ],
      "properties": {
        "risk_factors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sensitivity"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "sensitivity": {
                "type": "number"
              },
              "shock_range": {
                "type": "number"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "name",
          "assumptions"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "enum": [
              "base",
              "high_demand",
              "low_demand",
              "supply_shock",
              "energy_shock",
              "liquidity_crisis",
              "bubble",
              "crash",
              "provider_exit",
              "small_provider_influx",
              "custom"
            ]
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duration": {
            "type": "string"
          },
          "expected_outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parameter_change_method": {
          "type": "string"
        },
        "cooldown_period": {
          "type": "string"
        },
        "audit_required": {
          "type": "boolean"
        },
        "payment_rail_policy": {
          "type": "string"
        },
        "conversion_rate_disclosure": {
          "type": "string"
        },
        "zero_fee_conversion_rule": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "payment_rails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "preferred_service_unit",
        "participant_choice",
        "resource_credits",
        "crypto"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "const": "dual_optional"
        },
        "preferred_service_unit": {
          "type": "string",
          "enum": [
            "resource_credits",
            "crypto",
            "participant_choice"
          ]
        },
        "participant_choice": {
          "type": "string",
          "enum": [
            "free_choice",
            "service_dependent",
            "account_policy"
          ]
        },
        "resource_credits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "unit_id",
            "cash_convertible"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "unit_id": {
              "type": "string",
              "const": "RC"
            },
            "cash_convertible": {
              "type": "boolean",
              "const": false
            },
            "purchase_with_fiat": {
              "type": "boolean"
            },
            "earn_from_verified_contribution": {
              "type": "boolean"
            },
            "usable_for": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pricing_role": {
              "type": "string",
              "enum": [
                "primary_service_unit",
                "optional_service_unit"
              ]
            }
          }
        },
        "crypto": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "optional_for_participants",
            "direct_settlement_supported",
            "conversion_to_resource_credits_supported"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "optional_for_participants": {
              "type": "boolean"
            },
            "direct_settlement_supported": {
              "type": "boolean"
            },
            "conversion_to_resource_credits_supported": {
              "type": "boolean"
            },
            "accepted_assets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "price_volatility_isolated_from_service_pricing": {
              "type": "boolean"
            },
            "pricing_role": {
              "type": "string",
              "enum": [
                "secondary_settlement_unit",
                "primary_service_unit",
                "participant_choice"
              ]
            },
            "internal_exchange": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "crypto_to_resource_credits",
                "protocol_commission_rate",
                "protocol_flat_fee",
                "protocol_spread",
                "rate_source"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "crypto_to_resource_credits": {
                  "type": "boolean"
                },
                "resource_credits_to_crypto": {
                  "type": "boolean"
                },
                "protocol_commission_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "const": 0
                },
                "protocol_flat_fee": {
                  "type": "number",
                  "minimum": 0,
                  "const": 0
                },
                "protocol_spread": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "const": 0
                },
                "rate_source": {
                  "type": "string",
                  "enum": [
                    "published_reference_rate",
                    "external_market_reference",
                    "hybrid_reference",
                    "governance_set_rate"
                  ]
                },
                "rate_update_policy": {
                  "type": "string"
                },
                "participant_visible_quote": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  },
  "provenance_extension": {
    "status": "recommended_update",
    "change": "Added dual payment rails and fee-free internal crypto-to-Resource-Credit conversion with transparent reference-rate rules.",
    "backward_compatibility": "Existing required fields remain unchanged.",
    "design_note": "Resource Credits are optimized for predictable service consumption; crypto is an optional participant-selected settlement rail. A participant may prefer either rail, and crypto can optionally be converted to Resource Credits for service use.",
    "internal_conversion_rule": "UFCPS protocol commission = 0; internal spread = 0; external network fees, when applicable, remain external and must be disclosed.",
    "author_royalty_policy": "Universal rule: 0.001% of every transaction. No transaction-class exceptions are defined by this model."
  }
}
