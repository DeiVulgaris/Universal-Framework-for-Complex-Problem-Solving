{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufcps.org/swarm/compute_accounting_v1.json",
  "title": "UFCPS Compute Accounting v1",
  "description": "Machine-readable accounting record for verified computational resources supplied to UFCPS processes. Compensation is based on verified resource contribution supporting process continuity, not on successful resolution of the underlying research question.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accounting_version",
    "accounting_event_id",
    "verification_event_id",
    "resource_id",
    "provider_id",
    "process_id",
    "compute_unit_id",
    "verified_quantity",
    "compensation",
    "status"
  ],
  "properties": {
    "accounting_version": {
      "type": "string",
      "const": "v1"
    },
    "accounting_event_id": {
      "type": "string",
      "minLength": 1
    },
    "verification_event_id": {
      "type": "string",
      "minLength": 1
    },
    "resource_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "process_id": {
      "type": "string",
      "minLength": 1
    },
    "question_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "workload_id": {
      "type": "string"
    },
    "compute_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "verified_quantity": {
      "type": "number",
      "minimum": 0
    },
    "verification_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "process_continuity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "continuation_supported": {
          "type": "boolean"
        },
        "continuation_state_ref": {
          "type": "string",
          "minLength": 1
        },
        "outcome_independent_compensation": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "compensation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rate",
        "currency",
        "gross_amount",
        "author_royalty",
        "net_provider_amount"
      ],
      "properties": {
        "rate": {
          "type": "number",
          "minimum": 0
        },
        "rate_unit": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "gross_amount": {
          "type": "number",
          "minimum": 0
        },
        "network_fee": {
          "type": "number",
          "minimum": 0
        },
        "author_royalty_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1e-05
        },
        "author_royalty": {
          "type": "number",
          "minimum": 0
        },
        "net_provider_amount": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "deduplication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_fingerprint",
        "duplicate_check_status"
      ],
      "properties": {
        "claim_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "duplicate_check_status": {
          "type": "string",
          "enum": [
            "not_checked",
            "clear",
            "duplicate",
            "disputed"
          ]
        },
        "source_event_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "settlement_status": {
          "type": "string",
          "enum": [
            "pending",
            "eligible",
            "submitted",
            "settled",
            "reversed",
            "disputed"
          ]
        },
        "settlement_reference": {
          "type": "string"
        },
        "settled_at": {
          "type": "string"
        }
      }
    },
    "research_outcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome_class": {
          "type": "string",
          "enum": [
            "resolved",
            "partial",
            "negative",
            "inconclusive",
            "blocked",
            "unresolved",
            "not_available"
          ]
        },
        "record_ref": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "recorded",
        "verified",
        "accounting_eligible",
        "settled",
        "reversed",
        "disputed",
        "void"
      ]
    }
  }
}
