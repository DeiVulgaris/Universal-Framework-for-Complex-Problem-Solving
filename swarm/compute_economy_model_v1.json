{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufcps.org/swarm/compute_economy_model_v1.json",
  "title": "UFCPS Compute Economy Model v1",
  "description": "Machine-readable economic model for the UFCPS distributed compute economy. The model describes supply, demand, pricing, issuance, liquidity, volatility, reserves, transaction costs, provider economics, and stability scenarios. It is a simulation model, not a promise of financial return.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_version",
    "currency",
    "compute_market",
    "issuance",
    "settlement",
    "stability",
    "risk",
    "scenarios"
  ],
  "properties": {
    "model_version": {
      "type": "string",
      "const": "v1"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "simulation",
        "candidate",
        "validated",
        "deprecated"
      ]
    },
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency_id",
        "name",
        "supply_policy"
      ],
      "properties": {
        "currency_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "reference_currency": {
          "type": "string"
        },
        "supply_policy": {
          "type": "string",
          "enum": [
            "fixed",
            "bounded",
            "elastic",
            "compute_linked",
            "hybrid",
            "experimental"
          ]
        },
        "maximum_supply": {
          "type": "number",
          "minimum": 0
        },
        "initial_supply": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "compute_market": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demand",
        "supply",
        "pricing"
      ],
      "properties": {
        "demand": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline_units",
            "growth_rate"
          ],
          "properties": {
            "baseline_units": {
              "type": "number",
              "minimum": 0
            },
            "growth_rate": {
              "type": "number"
            },
            "demand_sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "supply": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline_units",
            "growth_rate"
          ],
          "properties": {
            "baseline_units": {
              "type": "number",
              "minimum": 0
            },
            "growth_rate": {
              "type": "number"
            },
            "provider_classes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "small_provider_share": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "utilization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minimum_viable_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "price_discovery"
          ],
          "properties": {
            "price_discovery": {
              "type": "string",
              "enum": [
                "fixed",
                "market",
                "auction",
                "negotiated",
                "dynamic_reference",
                "hybrid"
              ]
            },
            "reference_compute_unit": {
              "type": "string"
            },
            "base_price": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string"
            },
            "resource_adjustments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "issuance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "rate_policy",
        "limits"
      ],
      "properties": {
        "trigger": {
          "type": "string",
          "enum": [
            "verified_compute",
            "verified_settlement",
            "scheduled",
            "demand_linked",
            "hybrid",
            "experimental"
          ]
        },
        "rate_policy": {
          "type": "string",
          "enum": [
            "fixed_per_compute_unit",
            "dynamic",
            "market_clearing",
            "bounded_dynamic",
            "experimental"
          ]
        },
        "rate": {
          "type": "number",
          "minimum": 0
        },
        "rate_unit": {
          "type": "string"
        },
        "demand_adjustment": {
          "type": "number"
        },
        "utilization_adjustment": {
          "type": "number"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_issuance_per_period": {
              "type": "number",
              "minimum": 0
            },
            "max_issuance_rate": {
              "type": "number",
              "minimum": 0
            },
            "period": {
              "type": "string"
            }
          }
        }
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author_royalty_rate",
        "transaction_cost_model"
      ],
      "properties": {
        "author_royalty_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "const": 1e-05
        },
        "transaction_cost_model": {
          "type": "string",
          "enum": [
            "fixed",
            "percentage",
            "dynamic",
            "hybrid"
          ]
        },
        "base_transaction_fee": {
          "type": "number",
          "minimum": 0
        },
        "transaction_fee_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_settlement": {
          "type": "number",
          "minimum": 0
        },
        "batching_enabled": {
          "type": "boolean"
        },
        "micro_provider_settlement": {
          "type": "boolean"
        }
      }
    },
    "liquidity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_liquidity_ratio": {
          "type": "number",
          "minimum": 0
        },
        "reserve_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "settlement_depth_target": {
          "type": "number",
          "minimum": 0
        },
        "redemption_mechanism": {
          "type": "string"
        },
        "liquidity_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "volatility_target",
        "stabilization_policy"
      ],
      "properties": {
        "volatility_target": {
          "type": "number",
          "minimum": 0
        },
        "measurement_window": {
          "type": "string"
        },
        "stabilization_policy": {
          "type": "string",
          "enum": [
            "none",
            "reserve",
            "dynamic_issuance",
            "dynamic_pricing",
            "liquidity_buffer",
            "hybrid",
            "experimental"
          ]
        },
        "circuit_breakers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provider_economics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hardware_cost": {
          "type": "number",
          "minimum": 0
        },
        "energy_cost_per_compute_unit": {
          "type": "number",
          "minimum": 0
        },
        "maintenance_cost_per_period": {
          "type": "number",
          "minimum": 0
        },
        "depreciation_per_period": {
          "type": "number",
          "minimum": 0
        },
        "target_margin": {
          "type": "number"
        },
        "small_provider_minimum_viable_contribution": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "network_externalities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compute_demand_multiplier": {
          "type": "number",
          "minimum": 0
        },
        "resource_network_multiplier": {
          "type": "number",
          "minimum": 0
        },
        "participant_growth_rate": {
          "type": "number"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_factors"
      ],
      "properties": {
        "risk_factors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sensitivity"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "sensitivity": {
                "type": "number"
              },
              "shock_range": {
                "type": "number"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "name",
          "assumptions"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "enum": [
              "base",
              "high_demand",
              "low_demand",
              "supply_shock",
              "energy_shock",
              "liquidity_crisis",
              "bubble",
              "crash",
              "provider_exit",
              "small_provider_influx",
              "custom"
            ]
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duration": {
            "type": "string"
          },
          "expected_outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parameter_change_method": {
          "type": "string"
        },
        "cooldown_period": {
          "type": "string"
        },
        "audit_required": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
