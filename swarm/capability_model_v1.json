{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufcps.org/swarm/resource_registry_v1.json",
  "title": "UFCPS Resource Registry v1",
  "description": "Machine-readable registry model for heterogeneous computational and physical resources participating in UFCPS Level 2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "resources"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "const": "v1"
    },
    "updated_at": {
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "name"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "compute",
            "memory",
            "storage",
            "network",
            "sensing",
            "robotics",
            "laboratory",
            "workspace",
            "energy",
            "cooling",
            "other"
          ]
        },
        "performance": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "discovered",
            "available",
            "reserved",
            "active",
            "degraded",
            "failed",
            "maintenance",
            "released",
            "offline"
          ]
        },
        "available_capacity": {
          "type": "number",
          "minimum": 0
        },
        "capacity_unit": {
          "type": "string"
        },
        "schedule": {
          "type": "string"
        },
        "last_heartbeat": {
          "type": "string"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "location_type": {
          "type": "string",
          "enum": [
            "cloud",
            "datacenter",
            "home",
            "laboratory",
            "mobile",
            "unknown"
          ]
        },
        "region": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "economics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "price_per_unit": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "minimum_allocation": {
          "type": "number",
          "minimum": 0
        },
        "minimum_allocation_unit": {
          "type": "string"
        },
        "energy_cost_per_unit": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verification_methods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attestation_ref": {
          "type": "string"
        },
        "last_verified_at": {
          "type": "string"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "unverified",
            "pending",
            "verified",
            "rejected"
          ]
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "ownership_type": {
          "type": "string",
          "enum": [
            "owned",
            "leased",
            "shared",
            "borrowed",
            "unknown"
          ]
        }
      }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reservation_id": {
          "type": "string",
          "minLength": 1
        },
        "process_id": {
          "type": "string",
          "minLength": 1
        },
        "allocated_capacity": {
          "type": "number",
          "minimum": 0
        },
        "capacity_unit": {
          "type": "string"
        },
        "expires_at": {
          "type": "string"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "maintenance_due_at": {
          "type": "string"
        },
        "release_reason": {
          "type": "string"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_state_hash": {
          "type": "string",
          "minLength": 1
        },
        "provenance_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "resource_type",
        "status",
        "capabilities",
        "availability",
        "verification"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "resource_type": {
          "type": "string",
          "enum": [
            "cpu",
            "gpu",
            "accelerator",
            "memory",
            "storage",
            "bandwidth",
            "sensor",
            "robot",
            "laboratory",
            "workspace",
            "energy",
            "cooling",
            "compute_cluster",
            "other"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "discovered",
            "available",
            "reserved",
            "active",
            "degraded",
            "failed",
            "maintenance",
            "released",
            "offline"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "economics": {
          "$ref": "#/$defs/economics"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "ownership": {
          "$ref": "#/$defs/ownership"
        },
        "reservation": {
          "$ref": "#/$defs/reservation"
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "integrity": {
          "$ref": "#/$defs/integrity"
        },
        "substitution_group": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
