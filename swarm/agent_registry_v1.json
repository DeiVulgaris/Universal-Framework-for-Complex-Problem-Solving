{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufcps.org/swarm/agent_registry_v1.json",
  "title": "UFCPS Agent Registry v1",
  "description": "Machine-readable registry model for heterogeneous agents participating in UFCPS Level 2 Distributed Swarm Intelligence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "agents"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "const": "v1"
    },
    "updated_at": {
      "type": "string"
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agent"
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "name"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "reasoning",
            "planning",
            "simulation",
            "research",
            "experimentation",
            "validation",
            "coordination",
            "perception",
            "tool_use",
            "communication",
            "physical_control",
            "other"
          ]
        },
        "level": {
          "type": "number",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "resource_access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "access_type"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "access_type": {
          "type": "string",
          "enum": [
            "owner",
            "operator",
            "lease",
            "borrowed",
            "temporary"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "agent_type",
        "status",
        "capabilities",
        "task_policy"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "agent_type": {
          "type": "string",
          "enum": [
            "llm",
            "reasoning",
            "research",
            "validator",
            "planner",
            "hybrid",
            "physical",
            "human",
            "other"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "registered",
            "available",
            "busy",
            "degraded",
            "offline",
            "suspended",
            "released"
          ]
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "public_key": {
              "type": "string",
              "minLength": 1
            },
            "provider_id": {
              "type": "string",
              "minLength": 1
            },
            "model_family": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "resource_access": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource_access"
          }
        },
        "task_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accepts_tasks"
          ],
          "properties": {
            "accepts_tasks": {
              "type": "boolean"
            },
            "min_task_class": {
              "type": "string"
            },
            "max_concurrent_tasks": {
              "type": "integer",
              "minimum": 0
            },
            "allowed_problem_classes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "excluded_problem_classes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "reliability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "successful_transitions": {
              "type": "integer",
              "minimum": 0
            },
            "failed_transitions": {
              "type": "integer",
              "minimum": 0
            },
            "completed_tasks": {
              "type": "integer",
              "minimum": 0
            },
            "abandoned_tasks": {
              "type": "integer",
              "minimum": 0
            },
            "validation_pass_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "last_updated": {
              "type": "string"
            }
          }
        },
        "economics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "compute_price_per_unit": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "minLength": 1
            },
            "minimum_task_reward": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "available_now": {
              "type": "boolean"
            },
            "schedule": {
              "type": "string"
            },
            "heartbeat_interval_seconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "reputation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": "number"
            },
            "domain_scores": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registered_by": {
              "type": "string",
              "minLength": 1
            },
            "registered_at": {
              "type": "string"
            },
            "updated_at": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
